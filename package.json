{
	"name": "perseus",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"preview": "turbo preview",
		"check": "turbo check",
		"check:watch": "turbo check:watch",
		"format": "prettier --write .",
		"lint": "turbo lint",
		"test": "turbo test",
		"test:unit": "turbo test:unit",
		"test:e2e": "turbo test:e2e",
		"admin:upload": "bun scripts/admin-upload-puzzle.ts",
		"admin:startup:login": "bun scripts/admin-bulk-upload-startup.ts login",
		"admin:startup:set-token": "bun scripts/admin-bulk-upload-startup.ts set-token",
		"admin:startup:status": "bun scripts/admin-bulk-upload-startup.ts status",
		"admin:startup:upload": "bun scripts/admin-bulk-upload-startup.ts upload",
		"test:scripts": "bun test scripts/",
		"deploy": "PUBLIC_API_BASE= turbo build && turbo pulumi:up --filter=@perseus/infrastructure",
		"prepare": "husky"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.0.18",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"turbo": "^2.3.3",
		"wrangler": "4.60.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,md,css,html}": [
			"prettier --write"
		]
	}
}
