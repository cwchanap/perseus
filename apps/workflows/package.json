{
	"name": "@perseus/workflows",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --outdir dist --config wrangler.dev.toml",
		"dev:standalone": "wrangler dev --config wrangler.dev.toml --port 4691",
		"deploy": "wrangler deploy --config wrangler.production.toml",
		"test": "vitest run --coverage",
		"test:unit": "vitest run --coverage",
		"test:watch": "vitest",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint ."
	},
	"dependencies": {
		"@perseus/shared": "workspace:*",
		"@perseus/types": "workspace:*",
		"@cf-wasm/photon": "^0.4.0",
		"@cf-wasm/resvg": "^0.4.0",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261025.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5",
		"wrangler": "4.152.0"
	}
}
