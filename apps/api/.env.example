# Admin authentication passkey (required)
ADMIN_PASSKEY=your-secure-passkey-here

# JWT secret used to sign admin sessions (required, keep high-entropy)
JWT_SECRET=your-jwt-secret-here

# Optional: Cloudflare Access service token for prod admin CLI uploads
# (Pulumi outputs adminCliAccessClientId / adminCliAccessClientSecret).
# Used by: bun run admin:startup:upload
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Local HTTP OAuth callbacks require development mode
NODE_ENV=development

# Google OAuth for player sign-in
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
AUTH_REDIRECT_BASE_URL=http://localhost:4690

# Server port (optional, default: 3000)
PORT=3000

# Data directory (optional, default: ./data)
DATA_DIR=./data
